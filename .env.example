# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
VIDBRIEF_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
VIDBRIEF_SUMMARY_MODEL=openai/gpt-oss-120b
VIDBRIEF_DEFAULT_SUMMARY_LANGUAGE=pt-BR
VIDBRIEF_MAX_VIDEO_DURATION_SECONDS=7200
VIDBRIEF_AUDIO_CHUNK_MAX_MB=24
# Unset: sized automatically from the token limit Groq reports. Set it to pin the budget.
# VIDBRIEF_SUMMARY_MAX_REQUEST_TOKENS=6000
VIDBRIEF_REQUEST_TIMEOUT_SECONDS=120
VIDBRIEF_MAX_CONCURRENT_JOBS=1
VIDBRIEF_HOST=127.0.0.1
VIDBRIEF_PORT=8000
VIDBRIEF_LOG_LEVEL=INFO
